QWidget {
    background-color: #0d1117;
    color: #e6edf3;
    font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
}

QMainWindow, QDialog {
    background-color: #070d17;
}

QWidget#LauncherRoot {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #091321, stop:0.48 #0d1828, stop:1 #08111d);
}

QLabel#TitleLabel {
    font-size: 22px;
    font-weight: 800;
    letter-spacing: 2px;
    color: #ffffff;
}

QLabel#SubtitleLabel {
    color: #8b949e;
    font-size: 12px;
}

QLabel#SectionLabel {
    color: #58a6ff;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
}

QLabel#StatusOffline {
    color: #ff8793;
    background-color: rgba(255, 87, 106, 0.10);
    border: 1px solid rgba(255, 135, 147, 0.30);
    border-radius: 12px;
    padding: 6px 11px;
    font-weight: 700;
}

QLabel#StatusChecking {
    color: #b7c6da;
    background-color: rgba(142, 164, 194, 0.10);
    border: 1px solid rgba(142, 164, 194, 0.22);
    border-radius: 12px;
    padding: 6px 11px;
    font-weight: 700;
}

QLabel#StatusOnline {
    color: #6ce5c2;
    background-color: rgba(108, 229, 194, 0.10);
    border: 1px solid rgba(108, 229, 194, 0.28);
    border-radius: 12px;
    padding: 6px 11px;
    font-weight: 700;
}

QLabel#ErrorLabel {
    color: #f85149;
}

QLineEdit, QComboBox, QSpinBox {
    background-color: rgba(5, 13, 25, 0.72);
    border: 1px solid #263a55;
    border-radius: 10px;
    padding: 8px 10px;
    selection-background-color: #1f6feb;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border: 1px solid #58a6ff;
}

QLineEdit:hover, QComboBox:hover, QSpinBox:hover {
    border: 1px solid #444c56;
}

QLineEdit[echoMode="2"] {
    /* password fields keep the same look */
}

QPushButton {
    background-color: rgba(24, 43, 68, 0.82);
    border: 1px solid #2b4565;
    border-radius: 10px;
    padding: 9px 17px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #234469;
    border-color: #4a80b4;
}

QPushButton:pressed {
    background-color: #161b22;
}

QPushButton:disabled {
    color: #6e7681;
    background-color: #161b22;
}

QPushButton#AccentButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #5fe0d5, stop:1 #4e91ff);
    border: 1px solid #68dcd6;
    color: #ffffff;
    font-size: 15px;
    border-radius: 11px;
    padding: 10px 22px;
}

QPushButton#AccentButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #76eee1, stop:1 #6ba8ff);
}

QPushButton#DangerButton {
    background-color: #da3633;
    border: 1px solid #da3633;
    color: #ffffff;
}

QPushButton#GhostButton {
    background-color: transparent;
    border: 1px solid #30363d;
    color: #c9d1d9;
}

QPushButton#GhostButton:hover {
    background-color: #21262d;
}

QGroupBox {
    border: 1px solid #303f59;
    border-radius: 16px;
    margin-top: 16px;
    padding: 18px 12px 12px 12px;
    font-weight: 700;
    color: #9eb5d0;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 4px;
}

QGroupBox#PanelCard {
    background-color: rgba(15, 31, 51, 0.76);
    border: 1px solid rgba(106, 155, 207, 0.24);
}

QGroupBox#PanelCard::title {
    color: #78c8ff;
    letter-spacing: 1px;
    padding: 0 8px;
}

QCheckBox {
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #30363d;
    border-radius: 5px;
    background-color: #161b22;
}

QCheckBox::indicator:hover {
    border: 1px solid #58a6ff;
}

QCheckBox::indicator:checked {
    background-color: #1f6feb;
    border-color: #1f6feb;
    image: url(:/icons/check.svg);
}

QStatusBar {
    background-color: rgba(6, 14, 25, 0.92);
    color: #91a8c4;
    border-top: 1px solid rgba(106, 155, 207, 0.18);
}

QListWidget {
    background-color: #161b22;
    border: 1px solid #30363d;
    border-radius: 6px;
    outline: none;
}

QListWidget::item {
    padding: 6px 8px;
    border-radius: 4px;
}

QListWidget::item:selected {
    background-color: #1f6feb;
    color: #ffffff;
}

QListWidget::item:hover:!selected {
    background-color: #21262d;
}

QScrollBar:vertical {
    background: #0d1117;
    width: 10px;
}

QScrollBar::handle:vertical {
    background: #30363d;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

/* ---------- Login window ---------- */
QWidget#LoginRoot {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #10151c, stop:0.5 #0d1117, stop:1 #0b0f14);
    border: 1px solid #21262d;
    border-radius: 16px;
}

QWidget#LoginHeader {
    background: transparent;
}

QWidget#LoginBody {
    background: transparent;
}

QLabel {
    background: transparent;
}

QLabel#LoginBrand {
    color: #ffffff;
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 2px;
}

QLabel#LoginTitle {
    color: #ffffff;
    font-size: 21px;
    font-weight: 700;
}

QPushButton#IconButton {
    background: transparent;
    border: none;
    border-radius: 13px;
    padding: 0;
}

QPushButton#IconButton:hover {
    background: #21262d;
}

QPushButton#IconButton:pressed {
    background: #161b22;
}

QPushButton#CloseButton {
    background: transparent;
    border: none;
    border-radius: 13px;
    padding: 0;
}

QPushButton#CloseButton:hover {
    background: #da3633;
}

QPushButton#CloseButton:pressed {
    background: #b62324;
}

QProgressBar#BusyBar {
    background: transparent;
    border: none;
    max-height: 3px;
    margin-top: 2px;
}

QProgressBar#BusyBar::chunk {
    background-color: #1f6feb;
    border-radius: 2px;
}

/* ---------- Dashboard launcher ---------- */
QWidget#LauncherRoot {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #07101d, stop:0.45 #0d1a2c, stop:1 #08111f);
}

QFrame#Sidebar {
    background: qlineargradient(x1:0, y1:0, x2:0.8, y2:1,
                                stop:0 #111f35, stop:1 #0b1628);
    border: 1px solid rgba(117, 165, 224, 0.23);
    border-radius: 24px;
}

QLabel#BrandMark {
    color: #07111f;
    font-size: 19px;
    font-weight: 900;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #66e5e2, stop:1 #6db5ff);
    border-radius: 14px;
}

QLabel#BrandName {
    color: #ffffff;
    font-size: 18px;
    font-weight: 900;
    letter-spacing: 2px;
}

QLabel#BrandCaption, QLabel#SideCaption {
    color: #7590b2;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.4px;
}

QLabel#SideInfo {
    color: #9eb4d0;
    font-size: 11px;
}

QLabel#SideVersion {
    color: #5d7698;
    font-size: 10px;
    letter-spacing: .8px;
}

QFrame#SidebarStatus {
    background: rgba(5, 14, 27, .45);
    border: 1px solid rgba(117, 165, 224, .14);
    border-radius: 14px;
}

QPushButton#NavButtonActive {
    text-align: left;
    color: #08111f;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #66e5e2, stop:1 #6db5ff);
    border: none;
    border-radius: 13px;
    padding: 11px 14px;
    font-weight: 900;
    letter-spacing: .5px;
}

QPushButton#NavButtonActive:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #8af3e9, stop:1 #8ec5ff);
}

QFrame#HeroCard {
    min-height: 235px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #19365a, stop:0.52 #142746, stop:1 #102039);
    border: 1px solid rgba(109, 181, 255, .35);
    border-radius: 26px;
}

QLabel#HeroEyebrow, QLabel#SectionLabel {
    color: #66e5e2;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 1.8px;
}

QLabel#HeroTitle {
    color: #ffffff;
    font-size: 38px;
    font-weight: 900;
    letter-spacing: -1px;
    margin-top: 5px;
}

QLabel#HeroText {
    color: #a9c0dd;
    font-size: 14px;
}

QFrame#AccountCard {
    background: rgba(5, 14, 27, .42);
    border: 1px solid rgba(140, 191, 255, .22);
    border-radius: 19px;
}

QLabel#AvatarLabel {
    color: #08111f;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #ffc86b, stop:1 #ff8793);
    border: 3px solid rgba(255, 255, 255, .22);
    border-radius: 36px;
    font-size: 25px;
    font-weight: 900;
}

QLabel#AccountName {
    color: #ffffff;
    font-size: 17px;
    font-weight: 800;
}

QPushButton#LaunchButton {
    color: #07101d;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #ffc86b, stop:1 #ff8793);
    border: none;
    border-radius: 14px;
    padding: 12px 24px;
    font-size: 14px;
    font-weight: 900;
    letter-spacing: .8px;
}

QPushButton#LaunchButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #ffdc91, stop:1 #ff9da7);
}

QFrame#MetricCard {
    min-height: 72px;
    background: rgba(15, 30, 51, .76);
    border: 1px solid rgba(116, 169, 232, .20);
    border-radius: 16px;
}

QLabel#MetricLabel, QLabel#FieldLabel {
    color: #7290b4;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 1.2px;
}

QLabel#MetricValue {
    color: #f4f8ff;
    font-size: 16px;
    font-weight: 800;
}

QFrame#SurfaceCard {
    background: rgba(13, 28, 48, .78);
    border: 1px solid rgba(116, 169, 232, .20);
    border-radius: 19px;
}

QLineEdit#PathField {
    min-height: 38px;
    background: rgba(4, 12, 24, .64);
    border: 1px solid rgba(116, 169, 232, .25);
    border-radius: 11px;
    padding: 8px 12px;
    color: #e9f2ff;
}

QLineEdit#PathField:focus {
    border: 1px solid #66e5e2;
}

QFrame#FooterCard {
    background: rgba(13, 28, 48, .58);
    border: 1px solid rgba(116, 169, 232, .14);
    border-radius: 13px;
}

QLabel#FooterDot {
    color: #66e5e2;
    font-size: 15px;
}
