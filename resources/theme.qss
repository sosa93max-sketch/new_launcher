/* =========================================================
   D2Max Launcher — Midnight Compact Theme
   ========================================================= */

* {
    outline: none;
}

QWidget {
    background-color: #080c11;
    color: #c9d5e3;
    font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    font-size: 12px;
}

QMainWindow, QDialog {
    background-color: #06090d;
}

/* ---------- Scrollbars compactas ---------- */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #1e293b;
    border-radius: 3px;
    min-height: 16px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    background: transparent;
    height: 6px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #1e293b;
    border-radius: 3px;
    min-width: 16px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ---------- Inputs ---------- */
QLineEdit, QComboBox, QSpinBox {
    background-color: #0f141c;
    border: 1px solid #1e293b;
    border-radius: 8px;
    padding: 6px 9px;
    selection-background-color: #0ea5e9;
    min-height: 18px;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border: 1px solid #38bdf8;
}
QLineEdit:hover, QComboBox:hover, QSpinBox:hover {
    border: 1px solid #334155;
}
QComboBox::drop-down {
    border: none;
    width: 20px;
}
QComboBox QAbstractItemView {
    color: #e2e8f0;
    background: #0f141c;
    border: 1px solid #1e293b;
    selection-background-color: #0f172a;
    selection-color: #38bdf8;
    padding: 4px;
}

/* ---------- Botones base ---------- */
QPushButton {
    background-color: #131b26;
    border: 1px solid #1e293b;
    border-radius: 8px;
    padding: 7px 14px;
    font-weight: 600;
    color: #cbd5e1;
}
QPushButton:hover {
    background-color: #1a2533;
    border-color: #334155;
}
QPushButton:pressed {
    background-color: #0f141c;
}
QPushButton:disabled {
    color: #475569;
    background-color: #0b0f14;
    border-color: #131b26;
}

/* ---------- Botones especiales ---------- */
QPushButton#AccentButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #0ea5e9, stop:1 #6366f1);
    border: none;
    color: #ffffff;
    font-size: 13px;
    font-weight: 700;
    border-radius: 8px;
    padding: 8px 18px;
    letter-spacing: .4px;
}
QPushButton#AccentButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #38bdf8, stop:1 #818cf8);
}
QPushButton#AccentButton:disabled {
    background: #1e293b;
    color: #64748b;
}

QPushButton#DangerButton {
    background-color: #dc2626;
    border: 1px solid #dc2626;
    color: #ffffff;
}
QPushButton#DangerButton:hover {
    background-color: #ef4444;
}

QPushButton#GhostButton {
    background-color: transparent;
    border: 1px solid #1e293b;
    color: #94a3b8;
    padding: 6px 12px;
}
QPushButton#GhostButton:hover {
    background-color: #131b26;
    color: #e2e8f0;
    border-color: #334155;
}

QPushButton#IconButton {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 0;
}
QPushButton#IconButton:hover {
    background: #131b26;
}
QPushButton#CloseButton {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 0;
}
QPushButton#CloseButton:hover {
    background: #dc2626;
}
QPushButton#CloseButton:pressed {
    background: #b91c1c;
}

/* ---------- Labels globales ---------- */
QLabel {
    background: transparent;
}
QLabel#TitleLabel {
    font-size: 18px;
    font-weight: 800;
    letter-spacing: 1px;
    color: #f1f5f9;
}
QLabel#SubtitleLabel {
    color: #64748b;
    font-size: 11px;
}
QLabel#SectionLabel {
    color: #38bdf8;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
}
QLabel#ErrorLabel {
    color: #f87171;
    font-size: 11px;
    font-weight: 600;
}

/* ---------- Status pills ---------- */
QLabel#StatusOffline {
    color: #fca5a5;
    background-color: rgba(220, 38, 38, 0.10);
    border: 1px solid rgba(220, 38, 38, 0.25);
    border-radius: 8px;
    padding: 4px 8px;
    font-weight: 700;
    font-size: 10px;
}
QLabel#StatusChecking {
    color: #94a3b8;
    background-color: rgba(148, 163, 184, 0.08);
    border: 1px solid rgba(148, 163, 184, 0.18);
    border-radius: 8px;
    padding: 4px 8px;
    font-weight: 700;
    font-size: 10px;
}
QLabel#StatusOnline {
    color: #34d399;
    background-color: rgba(52, 211, 153, 0.08);
    border: 1px solid rgba(52, 211, 153, 0.22);
    border-radius: 8px;
    padding: 4px 8px;
    font-weight: 700;
    font-size: 10px;
}

/* ---------- Checkbox ---------- */
QCheckBox {
    spacing: 6px;
    font-size: 11px;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #1e293b;
    border-radius: 4px;
    background-color: #0f141c;
}
QCheckBox::indicator:hover {
    border-color: #38bdf8;
}
QCheckBox::indicator:checked {
    background-color: #0ea5e9;
    border-color: #0ea5e9;
    image: url(:/icons/check.svg);
}

/* ---------- Progress ---------- */
QProgressBar#BusyBar {
    background: transparent;
    border: none;
    max-height: 2px;
}
QProgressBar#BusyBar::chunk {
    background-color: #0ea5e9;
    border-radius: 1px;
}

/* ---------- StatusBar ---------- */
QStatusBar {
    background-color: #080c11;
    color: #64748b;
    border-top: 1px solid #0f141c;
    font-size: 11px;
}
QStatusBar::item {
    border: none;
}

/* =========================================================
   LOGIN WINDOW (Compact)
   ========================================================= */
QWidget#LoginRoot {
    background: #0b1016;
    border: 1px solid #131b26;
    border-radius: 12px;
}
QWidget#LoginHeader {
    background: transparent;
}
QWidget#LoginBody {
    background: transparent;
}
QLabel#LoginBrand {
    color: #f8fafc;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 1.5px;
}
QLabel#LoginTitle {
    color: #f8fafc;
    font-size: 17px;
    font-weight: 700;
}

/* =========================================================
   DASHBOARD (Compact)
   ========================================================= */
QWidget#LauncherRoot {
    background: #06090d;
}

QFrame#Sidebar {
    background: #0b1016;
    border: 1px solid #131b26;
    border-radius: 14px;
}
QLabel#BrandMark {
    color: #020617;
    font-size: 15px;
    font-weight: 900;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #34d399, stop:1 #0ea5e9);
    border-radius: 10px;
}
QLabel#BrandName {
    color: #f1f5f9;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 1.5px;
}
QLabel#BrandCaption, QLabel#SideCaption {
    color: #475569;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
}
QLabel#SideInfo {
    color: #64748b;
    font-size: 10px;
    line-height: 14px;
}
QLabel#SideVersion {
    color: #334155;
    font-size: 9px;
    letter-spacing: .5px;
}
QFrame#SidebarStatus {
    background: #0f141c;
    border: 1px solid #131b26;
    border-radius: 10px;
}

QPushButton#NavButtonActive {
    text-align: left;
    color: #020617;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #34d399, stop:1 #0ea5e9);
    border: none;
    border-radius: 8px;
    padding: 8px 10px;
    font-weight: 800;
    font-size: 11px;
    letter-spacing: .4px;
}
QPushButton#NavButtonActive:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #6ee7b7, stop:1 #38bdf8);
}
QPushButton#NavButton {
    text-align: left;
    color: #94a3b8;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 8px 10px;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: .4px;
}
QPushButton#NavButton:hover {
    color: #e2e8f0;
    background: rgba(56, 189, 248, 0.08);
    border-color: rgba(56, 189, 248, 0.14);
}

QFrame#HeroCard {
    min-height: 160px;
    background: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 14px;
}
QLabel#HeroEyebrow {
    color: #34d399;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 1.4px;
    text-transform: uppercase;
}
QLabel#HeroTitle {
    color: #f8fafc;
    font-size: 26px;
    font-weight: 800;
    letter-spacing: -0.5px;
}
QLabel#HeroText {
    color: #64748b;
    font-size: 12px;
}
QPushButton#LaunchButton {
    color: #020617;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #fbbf24, stop:1 #f59e0b);
    border: none;
    border-radius: 8px;
    padding: 9px 18px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .5px;
}
QPushButton#LaunchButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #fcd34d, stop:1 #fbbf24);
}

QFrame#AccountCard {
    background: #0b1016;
    border: 1px solid #1e293b;
    border-radius: 12px;
}
QLabel#AvatarLabel {
    color: #020617;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #fbbf24, stop:1 #f87171);
    border: 2px solid rgba(255, 255, 255, .12);
    border-radius: 28px;
    font-size: 18px;
    font-weight: 900;
}
QLabel#AccountName {
    color: #f1f5f9;
    font-size: 14px;
    font-weight: 800;
}
QLabel#AccountMeta {
    color: #475569;
    font-size: 11px;
}

QFrame#MetricCard {
    min-height: 56px;
    background: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 10px;
}
QLabel#MetricLabel, QLabel#FieldLabel {
    color: #475569;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
}
QLabel#MetricValue {
    color: #e2e8f0;
    font-size: 14px;
    font-weight: 800;
}

QFrame#SurfaceCard {
    background: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 12px;
}
QLineEdit#PathField {
    min-height: 32px;
    background: #0b1016;
    border: 1px solid #1e293b;
    border-radius: 8px;
    padding: 6px 10px;
    color: #e2e8f0;
}
QLineEdit#PathField:focus {
    border: 1px solid #38bdf8;
}

QFrame#FooterCard {
    background: #0b1016;
    border: 1px solid #131b26;
    border-radius: 8px;
}
QLabel#FooterDot {
    color: #34d399;
    font-size: 12px;
}

QScrollArea#DashboardScroll, QScrollArea#StoreScroll {
    background: transparent;
    border: none;
}
QScrollArea#DashboardScroll QWidget#qt_scrollarea_viewport,
QScrollArea#StoreScroll QWidget#qt_scrollarea_viewport {
    background: transparent;
}
QWidget#DashboardPage, QWidget#StorePage, QWidget#StoreBody {
    background: transparent;
}

/* =========================================================
   STORE (Compact)
   ========================================================= */
QLabel#StoreTitle {
    color: #f8fafc;
    font-size: 20px;
    font-weight: 800;
    letter-spacing: 1.2px;
}
QLabel#StoreSubtitle, QLabel#StoreMuted {
    color: #475569;
    font-size: 10px;
}
QPushButton#StoreBackButton {
    color: #94a3b8;
    background: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 10px;
    font-weight: 700;
}
QPushButton#StoreBackButton:hover {
    color: #f1f5f9;
    background: #1e293b;
    border-color: #38bdf8;
}

QFrame#StoreWalletCard {
    background: #0f172a;
    border: 1px solid rgba(251, 191, 36, 0.20);
    border-radius: 12px;
}
QLabel#StoreWalletIcon {
    color: #020617;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #fcd34d, stop:1 #f87171);
    border-radius: 8px;
    font-size: 14px;
    font-weight: 900;
}
QLabel#StoreOverline {
    color: #34d399;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 1.2px;
    text-transform: uppercase;
}
QLabel#StoreWalletValue {
    color: #f8fafc;
    font-size: 17px;
    font-weight: 900;
}

QFrame#StoreHeroCard {
    min-height: 100px;
    background: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 14px;
}
QLabel#StoreHeroTitle {
    color: #f8fafc;
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.3px;
}
QLabel#StoreHeroText {
    color: #64748b;
    font-size: 11px;
}
QFrame#StoreHeroBadge {
    min-width: 150px;
    background: #0b1016;
    border: 1px solid #1e293b;
    border-radius: 10px;
}
QLabel#StoreBadgeTitle {
    color: #e2e8f0;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1px;
}

QFrame#StoreFilterCard {
    background: #0b1016;
    border: 1px solid #131b26;
    border-radius: 10px;
}
QLineEdit#StoreSearch, QComboBox#StoreFilter {
    min-height: 32px;
    background: #0f141c;
    border: 1px solid #1e293b;
    border-radius: 8px;
    padding: 5px 8px;
    color: #e2e8f0;
    font-size: 11px;
}
QLineEdit#StoreSearch:focus, QComboBox#StoreFilter:focus {
    border-color: #38bdf8;
}

QPushButton#StoreSecondaryButton, QPushButton#StorePagerButton {
    color: #94a3b8;
    background: #131b26;
    border: 1px solid #1e293b;
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: .5px;
}
QPushButton#StoreSecondaryButton:hover, QPushButton#StorePagerButton:hover {
    color: #f1f5f9;
    background: #1e293b;
    border-color: #38bdf8;
}

QLabel#StoreSectionTitle {
    color: #94a3b8;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.2px;
    text-transform: uppercase;
}

QLabel#StoreInfo, QLabel#StoreError, QLabel#StoreSuccess {
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 10px;
    font-weight: 700;
}
QLabel#StoreInfo {
    color: #7dd3fc;
    background: rgba(14, 165, 233, 0.08);
    border: 1px solid rgba(14, 165, 233, 0.15);
}
QLabel#StoreError {
    color: #fca5a5;
    background: rgba(220, 38, 38, 0.08);
    border: 1px solid rgba(220, 38, 38, 0.15);
}
QLabel#StoreSuccess {
    color: #6ee7b7;
    background: rgba(52, 211, 153, 0.08);
    border: 1px solid rgba(52, 211, 153, 0.15);
}

QFrame#StoreProductCard {
    min-width: 170px;
    background: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 12px;
}
QFrame#StoreProductCard:hover {
    background: #111f35;
    border-color: rgba(56, 189, 248, 0.35);
}
QLabel#StoreProductBadge, QLabel#StoreOwnedBadge {
    border-radius: 5px;
    padding: 3px 6px;
    font-size: 8px;
    font-weight: 900;
    letter-spacing: .4px;
    text-transform: uppercase;
}
QLabel#StoreProductBadge {
    color: #020617;
    background: #34d399;
}
QLabel#StoreOwnedBadge {
    color: #94a3b8;
    background: rgba(56, 189, 248, 0.08);
    border: 1px solid rgba(56, 189, 248, 0.12);
}
QLabel#StoreProductName {
    color: #f1f5f9;
    font-size: 13px;
    font-weight: 800;
}
QLabel#StoreProductDescription {
    color: #475569;
    font-size: 10px;
}
QLabel#StoreProductHero {
    color: #38bdf8;
    font-size: 9px;
    font-weight: 700;
}
QLabel#StoreProductPrice {
    color: #fbbf24;
    font-size: 16px;
    font-weight: 900;
}
QLabel#StoreProductPriceMeta {
    color: #475569;
    font-size: 9px;
}

QPushButton#StoreBuyButton {
    min-height: 28px;
    color: #020617;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #34d399, stop:1 #0ea5e9);
    border: none;
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 9px;
    font-weight: 900;
    letter-spacing: .5px;
}
QPushButton#StoreBuyButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #6ee7b7, stop:1 #38bdf8);
}
QPushButton#StoreBuyButton:disabled {
    color: #475569;
    background: #131b26;
    border: 1px solid #1e293b;
}

QFrame#StorePanel {
    min-height: 120px;
    background: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 12px;
}
QFrame#StoreListRow {
    background: #0b1016;
    border: 1px solid #131b26;
    border-radius: 6px;
}
QLabel#StoreListPrimary {
    color: #cbd5e1;
    font-size: 10px;
    font-weight: 700;
}
QLabel#StoreListAccent {
    color: #34d399;
    font-size: 10px;
    font-weight: 900;
}
QLabel#StorePageLabel {
    min-width: 40px;
    color: #64748b;
    font-size: 10px;
    font-weight: 800;
    qproperty-alignment: AlignCenter;
}

QFrame#StoreEmptyState, QFrame#StoreSessionGate {
    min-height: 140px;
    background: #0b1016;
    border: 1px dashed #1e293b;
    border-radius: 12px;
}
QLabel#StoreEmptyTitle {
    color: #e2e8f0;
    font-size: 15px;
    font-weight: 800;
    qproperty-alignment: AlignCenter;
}
